# Copy to .env.local and fill in.

# Anthropic API key — writes the script, visual bible, and scene prompts.
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# ElevenLabs API key — lists your voices and generates the timestamped voiceover.
# https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=...

# Google AI Studio key — Gemini image generation ("Nano Banana") for reference
# images and scene starting frames. Optional: only needed for in-app image
# generation; the prompt-copy / manual workflow works without it.
# https://aistudio.google.com/apikey
GEMINI_API_KEY=...
