# Copy to .env.local and fill in. Both keys are required.

# Anthropic API key — writes the script, visual bible, and scene prompts.
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# ElevenLabs API key — lists your voices and generates the timestamped voiceover.
# https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=...
